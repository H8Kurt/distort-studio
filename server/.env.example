# Server
PORT=4000

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASS=change_me
DB_NAME=distortstudio_dev

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Frontend URL (для ссылок в письмах)
APP_URL=http://localhost:5173

# SMTP (Яндекс/Gmail и т.п.). Если не задано — письма не отправляются, ссылки пишутся в лог.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@yandex.ru
SMTP_PASS=app_password
MAIL_FROM="Distort Studio <no-reply@distort.studio>"

# Payments (маркетплейс)
# mock — локальная оплата без реальных денег (кнопка «Оплатить» в dev).
# yookassa — реальные платежи по СБП (нужны shopId и секретный ключ из личного кабинета ЮKassa).
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
